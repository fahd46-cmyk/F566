rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUserVerification(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.email is string &&
             data.email.size() >= 3 &&
             data.email.size() <= 254 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 120 &&
             data.otpCode is string &&
             data.otpCode.size() == 6 &&
             data.otpCode.matches('^[0-9]{6}$') &&
             data.isVerified is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /user_verifications/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId',
                         'email',
                         'displayName',
                         'otpCode',
                         'isVerified',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'email',
                         'displayName',
                         'otpCode',
                         'isVerified',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidUserVerification(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserVerification(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['otpCode', 'isVerified', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['otpCode', 'isVerified', 'displayName', 'updatedAt'])
                       );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
